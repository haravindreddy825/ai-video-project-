# ==========================================
# OpenSource AI Video Studio - Environment
# ==========================================
# Copy to .env and fill in values. NEVER commit .env.

# --- Application ---
APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# --- Database (SQLite local default; uncomment PostgreSQL for Docker/Prod) ---
DATABASE_URL=sqlite+aiosqlite:///./storage/ai_video_studio.db
# DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/ai_video_studio

# --- Redis & Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# --- Storage Paths ---
STORAGE_ROOT=./storage
MAX_MODEL_STORAGE_GB=120
MIN_FREE_DISK_GB=40

# --- Hardware & VRAM Scheduler ---
COMPUTE_MODE=local_hybrid
LOCAL_VRAM_LIMIT_MB=5800
SEQUENTIAL_GPU_LOCK=true

# --- Local AI Services ---
COMFYUI_URL=http://127.0.0.1:8188
TTS_ENGINE=kokoro
ASR_ENGINE=faster-whisper
ASR_MODEL_SIZE=base.en
AVATAR_ENGINE=ditto
VISUAL_ENGINE=hybrid_slide_sdxl_turbo

# --- Optional Cloud GPU Backend (Server-Side Only) ---
CLOUD_GPU_PROVIDER=none
CLOUD_GPU_API_KEY=
CLOUD_GPU_ENDPOINT=
CLOUD_AVATAR_ENGINE=echomimic_v2
